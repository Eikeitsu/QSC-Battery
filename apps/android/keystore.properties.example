# Companion APP release signing (open-source Magisk companion).
# Keep signatures stable across CI builds so in-app / module APK updates can replace installs.
# First cutover from old debug-signed APKs requires uninstall once.
storeFile=keystore/qsc-release.jks
storePassword=qsc-battery-release
keyAlias=qsc
keyPassword=qsc-battery-release
