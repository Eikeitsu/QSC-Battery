{
  // 电流控制总开关：0 关闭，1 开启。默认关闭。
  "current_control": 0,

  // 旁路总开关：0 关，1 开。关闭后不触发旁路与旁路回补（保留下方阈值配置）。
  "bypass_enable": 0,

  // 模拟旁路：电量 >= 该值时进入旁路策略。填 110 关闭。
  "battery_stop": 110,

  // 旁路温度：电池温度 >= 该值时进入旁路。填 110 关闭。与电量/时段为「或」关系。
  "bypass_temp": 110,

  // 旁路时段：字符串数组，格式 "HH:MM-HH:MM"（支持跨天，如 "22:00-08:00"）。空数组关闭。
  "bypass_schedule": [],

  // 旁路方式：sim=仅写电流（默认，最稳妥）；auto=若本机存在已知旁路节点则优先用节点，否则回退 sim。
  // 不会改温控文件，也不会做内核补丁。
  "bypass_mode": "sim",

  // 旁路安全温度上限 (°C)：达到后不写 0 / 不开节点旁路，改为二限小电流。
  "safety_temp_max": 48,

  // 慢充：电量 >= 该值且未进模拟旁路时，使用二限小电流。填 110 关闭。
  "slow_charge": 110,

  // 默认充电电流上限（微安），例如 5000000 = 5A。未触发其它策略时写入此目标（可抬流）。
  "default_current_max": 5000000,

  // 电流温控：0 关，1 开。
  "temperature_current": 0,

  // 一限温度 (°C) / 一限电流（微安）
  "default_current_limit": 40,
  "default_current_max_limit": 1500000,

  // 二限电流值：默认值100000为100毫安，此数值同时也是模拟旁路回补和慢充的小电流值（建议 >=100000）
  "temperature_current_limit": 45,
  "constant_current_max": 100000,

  // 游戏限流：0 关，1 开；仅匹配前台窗口；电流单位微安；包名为字符串数组
  "app_limit": 0,
  "app_current_max": 200000,
  "app_list": [
    "com.tencent.tmgp.sgame",
    "com.tencent.tmgp.pubgmhd",
    "com.miHoYo.Yuanshen",
    "com.tencent.lolm"
  ],

  // 电流节点：用户补充列表。运行时主写 constant_charge_current_max（不含 usb），
  // 再合并电池侧补充节点与 restrict*_cur*；本数组仅作额外补充。
  "battery_current": [
    "/sys/class/power_supply/main/constant_charge_current_max",
    "/sys/class/power_supply/battery/constant_charge_current_max",
    "/sys/class/power_supply/battery/constant_charge_current",
    "/sys/class/power_supply/battery/current_max"
  ],

  // 可选：台阶写入（微安）。0 或不写=直接写目标。如需兼容旧机可设 500000。
  // "current_step_ua": 0,

  // 可选：偏高时周期重申间隔（秒）。默认 24；电流已压住则跳过。0=关闭周期重申。
  // "current_reaffirm_sec": 24,

  // 可选：偏高裕量（微安）。仅「实测 > 目标+裕量」才漂移/周期强制；偏低不重申。默认 300000。
  // "current_drift_ua": 300000,

  // 限流前写入的策略参数。字符串格式："路径 value=值"。空数组则跳过。
  "restricted": [
    "/sys/class/qcom-battery/restrict_chg value=1",
    "/sys/class/qcom-battery/restricted_charging value=1",
    "/sys/class/power_supply/battery/step_charging_enabled value=0"
  ]
}
