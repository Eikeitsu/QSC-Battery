        <!-- 本体始终启用；桌面图标只在 alias 间切换，避免禁用 target 导致切换失效 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.QscBattery"
            android:windowSoftInputMode="adjustResize" />

        <!-- 静态默认（动态电量关闭时） -->
